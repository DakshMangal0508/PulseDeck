# Public frontend origin. Also used to build phone pairing links and OAuth return links.
PULSEDECK_FRONTEND_URL=https://pulsedeck.example.com

# Exact frontend origins, comma-separated if there is more than one.
PULSEDECK_ALLOWED_ORIGINS=https://pulsedeck.example.com

# Enable only when initial account creation/pairing must happen remotely.
PULSEDECK_ALLOW_REMOTE_SETUP=true

# Email recovery (SMTP). Use an app password for providers such as Gmail.
PULSEDECK_SMTP_HOST=smtp.example.com
PULSEDECK_SMTP_PORT=587
PULSEDECK_SMTP_USERNAME=
PULSEDECK_SMTP_PASSWORD=
PULSEDECK_SMTP_FROM=
PULSEDECK_SMTP_USE_SSL=false
PULSEDECK_SMTP_STARTTLS=true

# Mount this path on persistent storage in the backend deployment.
PULSEDECK_DATA_DIR=D:\pulsedeck-data

# Register the exact callback URI with Spotify.
PULSEDECK_SPOTIFY_CLIENT_ID=
PULSEDECK_SPOTIFY_CLIENT_SECRET=
PULSEDECK_SPOTIFY_REDIRECT_URI=https://api.example.com/api/spotify/callback

